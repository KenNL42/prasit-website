{
  "name": "Prasit-website",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/py.mjs scripts/render-viewer.py && astro dev",
    "build": "astro build",
    "prebuild": "node scripts/generate-og-image.mjs && node scripts/convert-bibliography.mjs && node scripts/py.mjs scripts/sync-access.py && node scripts/py.mjs scripts/render-viewer.py",
    "preview": "astro preview",
    "check": "astro check",
    "generate:placeholders": "node scripts/generate-placeholders.mjs",
    "generate:og": "node scripts/generate-og-image.mjs",
    "convert:bibliography": "node scripts/convert-bibliography.mjs",
    "sync:access": "node scripts/py.mjs scripts/sync-access.py",
    "render:viewer": "node scripts/py.mjs scripts/render-viewer.py",
    "deploy": "npm run build && node scripts/write-vercel-json.mjs && npx vercel deploy dist --prod",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "adm-zip": "^0.6.1",
    "astro": "^7.3.2",
    "marked": "^18.0.13",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
