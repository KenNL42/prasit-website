---
import { SITE } from '../site.config';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-paper-dark">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      <p class="font-serif text-lg font-semibold text-ink">{SITE.name}</p>
      <p class="mt-2 max-w-xs text-sm leading-relaxed text-ink-soft">{SITE.title}</p>
      <p class="mt-2 max-w-xs text-sm leading-relaxed text-ink-soft">{SITE.affiliation}</p>
    </div>

    <nav aria-label="Footer">
      <p class="text-xs font-semibold uppercase tracking-widest text-ink-soft">Site</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/about" class="text-ink-soft transition-colors hover:text-navy">About</a></li>
        <li><a href="/publications" class="text-ink-soft transition-colors hover:text-navy">Publications</a></li>
        <li><a href="/events" class="text-ink-soft transition-colors hover:text-navy">Fieldwork &amp; Events</a></li>
        <li><a href="/contact" class="text-ink-soft transition-colors hover:text-navy">Contact</a></li>
      </ul>
    </nav>

    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-ink-soft">Contact</p>
      <p class="mt-3 flex items-start gap-2 text-sm text-ink-soft">
        <Icon name="mail" class="mt-0.5 h-4 w-4 shrink-0 text-navy" />
        <a href={`mailto:${SITE.email}`} class="break-all transition-colors hover:text-navy">{SITE.email}</a>
      </p>
      <p class="mt-3 flex items-start gap-2 text-sm text-ink-soft">
        <Icon name="location" class="mt-0.5 h-4 w-4 shrink-0 text-navy" />
        <span>{SITE.address.join(' · ')}</span>
      </p>
    </div>
  </div>

  <div class="border-t border-line">
    <p class="mx-auto max-w-6xl px-4 py-5 text-xs text-ink-soft sm:px-6">
      © {year} {SITE.name}. All rights reserved.
    </p>
  </div>
</footer>
