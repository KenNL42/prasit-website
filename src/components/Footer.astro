---
import { SITE } from '../site.config';
import { getDictionary, type Locale } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getDictionary(lang);
const prefix = lang === 'th' ? '/th' : '';

// Localized identity: name, title, affiliation and address have Thai variants.
const name = lang === 'th' ? SITE.nameTh : SITE.name;
const title = lang === 'th' ? SITE.titleTh : SITE.title;
const affiliation = lang === 'th' ? SITE.affiliationTh : SITE.affiliation;
const address = lang === 'th' ? SITE.addressTh : SITE.address;

const links = [
  { href: '/about', label: t.nav.about },
  { href: '/publications', label: t.nav.publications },
  { href: '/events', label: t.nav.events },
  { href: '/contact', label: t.nav.contact },
];
---

<footer class="border-t border-line bg-paper-dark">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div lang={lang === 'th' ? 'th' : 'en'}>
      <p class="font-serif text-lg font-semibold text-ink">{name}</p>
      <p class="mt-2 max-w-xs text-sm leading-relaxed text-ink-soft">{title}</p>
      <p class="mt-2 max-w-xs text-sm leading-relaxed text-ink-soft">{affiliation}</p>
    </div>

    <nav aria-label={t.footer.site}>
      <p class="text-xs font-semibold uppercase tracking-widest text-ink-soft">{t.footer.site}</p>
      <ul class="mt-3 space-y-2 text-sm">
        {links.map((link) => (
          <li><a href={`${prefix}${link.href}`} class="text-ink-soft transition-colors hover:text-navy">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-ink-soft">{t.footer.contact}</p>
      <p class="mt-3 flex items-start gap-2 text-sm text-ink-soft">
        <Icon name="mail" class="mt-0.5 h-4 w-4 shrink-0 text-navy" />
        <a href={`mailto:${SITE.email}`} class="break-all transition-colors hover:text-navy">{SITE.email}</a>
      </p>
      <p class="mt-3 flex items-start gap-2 text-sm text-ink-soft">
        <Icon name="location" class="mt-0.5 h-4 w-4 shrink-0 text-navy" />
        <span>{address.join(' · ')}</span>
      </p>
    </div>
  </div>

  <div class="border-t border-line">
    <p class="mx-auto max-w-6xl px-4 py-5 text-xs text-ink-soft sm:px-6">
      {t.footer.rights(name)}
    </p>
  </div>
</footer>
