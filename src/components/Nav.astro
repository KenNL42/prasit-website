---
import { SITE } from '../site.config';
import { getDictionary, neutralPath, otherLocaleUrl, type Locale } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getDictionary(lang);

// Localized name (Thai on /th/ pages) and its monogram initial.
const brandName = lang === 'th' ? SITE.nameTh : SITE.name;
const brandInitial = brandName
  .replace(/^(Dr\.|ดร\.)\s*/, '')
  .trim()
  .charAt(0);

const links = [
  { href: '/', label: t.nav.home },
  { href: '/about', label: t.nav.about },
  { href: '/publications', label: t.nav.publications },
  { href: '/events', label: t.nav.events },
  { href: '/contact', label: t.nav.contact },
];

// Compare against the language-neutral path so the active state works on
// both the root (English) and /th/ (Thai) pages.
const path = neutralPath(lang, Astro.url.pathname);
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);

const switchHref = otherLocaleUrl(lang, path);
const switchLabel = lang === 'en' ? 'ไทย' : 'English';
const switchTitle = lang === 'en' ? 'เปลี่ยนเป็นภาษาไทย' : 'Switch to English';
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6" aria-label="Main navigation">
    <a href={lang === 'th' ? '/th/' : '/'} class="flex items-center gap-2.5" aria-label={`${brandName} — ${lang === 'th' ? 'หน้าแรก' : 'home'}`} lang={lang}>
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-navy font-serif text-lg font-semibold text-paper">
        {brandInitial}
      </span>
      <span class="hidden leading-tight sm:block">
        <span class="block font-serif text-[15px] font-semibold tracking-tight text-ink">{brandName}</span>
        <span class="block text-[11px] uppercase tracking-widest text-ink-soft">{lang === 'th' ? 'มานุษยวิทยา' : 'Anthropology'}</span>
      </span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={lang === 'th' && link.href === '/' ? '/th/' : `${lang === 'th' ? '/th' : ''}${link.href}`}
              class:list={[
                'rounded-md px-3 py-2 text-sm font-medium transition-colors',
                isActive(link.href) ? 'text-navy' : 'text-ink-soft hover:text-ink',
              ]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="ml-1">
        <a
          href={switchHref}
          hreflang={lang === 'en' ? 'th' : 'en'}
          title={switchTitle}
          class="inline-flex items-center gap-1.5 rounded-full border border-line bg-white px-3.5 py-2 text-sm font-semibold text-navy transition-colors hover:border-navy"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <path d="M2 12h20" />
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
          {switchLabel}
        </a>
      </li>
      <li class="ml-2">
        <a
          href={lang === 'th' ? '/th/contact' : '/contact'}
          class="inline-flex items-center gap-1.5 rounded-full bg-navy px-4 py-2 text-sm font-medium text-paper transition-colors hover:bg-navy-light"
        >
          {t.nav.cta}
        </a>
      </li>
    </ul>

    <!-- Mobile menu button -->
    <button
      id="nav-toggle"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-md text-ink-soft transition-colors hover:bg-paper-dark hover:text-ink md:hidden"
      aria-label={lang === 'th' ? 'เปิดเมนูนำทาง' : 'Toggle navigation menu'}
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-line bg-paper md:hidden">
    <ul class="mx-auto max-w-6xl space-y-1 px-4 py-3">
      {
        links.map((link) => (
          <li>
            <a
              href={lang === 'th' && link.href === '/' ? '/th/' : `${lang === 'th' ? '/th' : ''}${link.href}`}
              class:list={[
                'block rounded-md px-3 py-2.5 text-sm font-medium transition-colors',
                isActive(link.href) ? 'bg-paper-dark text-navy' : 'text-ink-soft hover:bg-paper-dark hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-1">
        <a
          href={switchHref}
          hreflang={lang === 'en' ? 'th' : 'en'}
          class="flex items-center gap-2 rounded-md px-3 py-2.5 text-sm font-semibold text-navy"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <path d="M2 12h20" />
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
          {switchLabel}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden', expanded);
    });
    // Close the menu when a link is chosen.
    menu.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        menu.classList.add('hidden');
      });
    });
  }
</script>
