---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { coverPhotoUrl, listAlbumPhotos } from '../lib/albums';

interface Props {
  event: CollectionEntry<'events'>;
}

const { event } = Astro.props;
const cover = coverPhotoUrl(event.data.album, event.data.cover);
const photoCount = listAlbumPhotos(event.data.album).length;
const formattedDate = event.data.date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a
  href={`/events/${event.id}/`}
  class="group flex flex-col overflow-hidden rounded-xl border border-line bg-white shadow-sm transition-shadow hover:shadow-md"
>
  <div class="relative aspect-[4/3] overflow-hidden bg-paper-dark">
    {
      cover ? (
        <img
          src={cover}
          alt={`Cover photo — ${event.data.title}`}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-ink-soft">
          <Icon name="university" class="h-10 w-10 opacity-40" />
        </div>
      )
    }
    {
      photoCount > 0 && (
        <span class="absolute bottom-3 right-3 rounded-full bg-ink/70 px-3 py-1 text-xs font-medium text-paper backdrop-blur">
          {photoCount} photo{photoCount === 1 ? '' : 's'}
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-center gap-2 text-xs text-ink-soft">
      <Icon name="calendar" class="h-3.5 w-3.5 text-navy" />
      <time datetime={event.data.date.toISOString()}>{formattedDate}</time>
      {
        event.data.location && (
          <span class="inline-flex items-center gap-1">
            <Icon name="location" class="h-3.5 w-3.5 text-navy" />
            {event.data.location}
          </span>
        )
      }
    </div>
    <h3 class="mt-2 font-serif text-lg font-semibold text-ink transition-colors group-hover:text-navy">
      {event.data.title}
    </h3>
    {
      event.data.tags.length > 0 && (
        <p class="mt-2 flex flex-wrap gap-1.5">
          {event.data.tags.map((tag) => (
            <span class="rounded-full bg-paper-dark px-2.5 py-0.5 text-[11px] text-ink-soft">{tag}</span>
          ))}
        </p>
      )
    }
    <p class="mt-auto flex items-center gap-1.5 pt-4 text-sm font-medium text-navy">
      View gallery
      <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
    </p>
  </div>
</a>
