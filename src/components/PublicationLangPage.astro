---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import PublicationList from './PublicationList.astro';
import { SITE } from '../site.config';
import { getCollection } from 'astro:content';
import { pdfUrl } from '../lib/publications';
import { getDictionary, type Locale } from '../i18n';

interface Props {
  /** UI language of the page ("en" or "th"). */
  lang: Locale;
  /** Which publications to list: "en" or "th". */
  language: 'en' | 'th';
}

const { lang, language } = Astro.props;
const t = getDictionary(lang);
const all = await getCollection('publications');
const pubs = all.filter((p) => p.data.language === language);

const title = language === 'th' ? t.publications.thTitle : t.publications.enTitle;
const intro = language === 'th' ? t.publications.thIntro : t.publications.enIntro;
const metaDescription = language === 'th'
  ? lang === 'th'
    ? 'บทความและงานเขียนภาษาไทยของอาจารย์ พร้อมบทคัดย่อและไฟล์ PDF'
    : 'Thai-language journal articles and essays, with abstracts and downloadable PDFs.'
  : 'English-language journal articles, book chapters and reviews, with abstracts and downloadable PDFs.';

const backHref = language === 'th' ? t.publications.backToEn : t.publications.backToTh;
const backTarget: 'en' | 'th' = language === 'th' ? 'en' : 'th';
const prefix = lang === 'th' ? '/th' : '';

// schema.org ItemList of ScholarlyArticle entries for this language page.
const articleLd = [
  {
    '@type': 'ItemList',
    name: title,
    itemListElement: pubs.map((pub, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'ScholarlyArticle',
        name: pub.data.title,
        author: pub.data.authors.map((name) => ({ '@type': 'Person', name })),
        datePublished: String(pub.data.year),
        inLanguage: pub.data.language === 'th' ? 'th' : 'en',
        ...(pub.data.journal
          ? { isPartOf: { '@type': 'Periodical', name: pub.data.journal } }
          : {}),
        ...(pdfUrl(pub) ? { url: new URL(pdfUrl(pub)!, SITE.url).toString() } : {}),
      },
    })),
  },
];
---

<Layout title={title} description={metaDescription} lang={lang} jsonLd={articleLd}>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center gap-2 text-sm text-ink-soft">
        <li><a href={`${prefix}/publications`} class="transition-colors hover:text-navy">{t.publications.breadcrumb}</a></li>
        <li aria-hidden="true"><Icon name="chevron-right" class="h-3.5 w-3.5" /></li>
        <li class="text-ink">{language === 'th' ? t.publications.thai : t.publications.english}</li>
      </ol>
    </nav>

    <div class="max-w-3xl">
      <div class="flex items-center gap-3">
        <h1 class="font-serif text-4xl font-semibold text-ink">{title}</h1>
        <span class="rounded-full bg-paper-dark px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-navy">
          {t.common.entries(pubs.length)}
        </span>
      </div>
      <p class="mt-4 text-[15px] leading-relaxed text-ink-soft">{intro}</p>
      <p class="mt-3">
        <a
          href={`${prefix}/publications/${backTarget}`}
          class="inline-flex items-center gap-1.5 text-sm font-medium text-navy transition-colors hover:text-navy-light"
        >
          <Icon name="arrow-right" class="h-4 w-4 rotate-180" />
          {backHref}
        </a>
      </p>
    </div>

    <div class="mt-10">
      <PublicationList publications={pubs} lang={lang} />
    </div>
  </div>
</Layout>
