---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import PublicationList from './PublicationList.astro';
import { SITE } from '../site.config';
import { getCollection } from 'astro:content';
import { LANGUAGE_LABELS, pdfUrl } from '../lib/publications';

interface Props {
  language: 'en' | 'th';
}

const { language } = Astro.props;
const all = await getCollection('publications');
const pubs = all.filter((p) => p.data.language === language);
const isThai = language === 'th';
const title = isThai ? 'สิ่งพิมพ์ภาษาไทย' : 'Publications in English';
const metaDescription = isThai
  ? 'บทความและงานเขียนภาษาไทยของอาจารย์ พร้อมบทคัดย่อและไฟล์ PDF'
  : 'English-language journal articles, book chapters and reviews, with abstracts and downloadable PDFs.';
const intro = isThai
  ? 'งานเขียนภาษาไทยมุ่งสู่ผู้อ่านในประเทศ ทั้งนักศึกษา นักวิชาการ และผู้ปฏิบัติงานด้านวัฒนธรรม เพื่อให้ความรู้ทางมานุษยวิทยาเข้าถึงสังคมที่เราศึกษา'
  : 'Journal articles, book chapters and reviews written for an international readership.';
const backLabel = isThai ? 'ดูสิ่งพิมพ์ภาษาอังกฤษ' : 'View Thai publications';
const backHref = isThai ? '/publications/english' : '/publications/thai';
const pageLang: 'en' | 'th' = language;

// schema.org ItemList of ScholarlyArticle entries for this language page.
const articleLd = [
  {
    '@type': 'ItemList',
    name: title,
    itemListElement: pubs.map((pub, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'ScholarlyArticle',
        name: pub.data.title,
        author: pub.data.authors.map((name) => ({ '@type': 'Person', name })),
        datePublished: String(pub.data.year),
        inLanguage: pub.data.language === 'th' ? 'th' : 'en',
        ...(pub.data.journal
          ? { isPartOf: { '@type': 'Periodical', name: pub.data.journal } }
          : {}),
        ...(pdfUrl(pub) ? { url: new URL(pdfUrl(pub)!, SITE.url).toString() } : {}),
      },
    })),
  },
];
---

<Layout title={title} description={metaDescription} lang={pageLang} jsonLd={articleLd}>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center gap-2 text-sm text-ink-soft">
        <li><a href="/publications" class="transition-colors hover:text-navy">Publications</a></li>
        <li aria-hidden="true"><Icon name="chevron-right" class="h-3.5 w-3.5" /></li>
        <li class="text-ink">{LANGUAGE_LABELS[language]}</li>
      </ol>
    </nav>

    <div class="max-w-3xl">
      <div class="flex items-center gap-3">
        <h1 class="font-serif text-4xl font-semibold text-ink">{title}</h1>
        <span class="rounded-full bg-paper-dark px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-navy">
          {pubs.length} {isThai ? 'รายการ' : pubs.length === 1 ? 'entry' : 'entries'}
        </span>
      </div>
      <p class="mt-4 text-[15px] leading-relaxed text-ink-soft">{intro}</p>
      <p class="mt-3">
        <a
          href={backHref}
          class="inline-flex items-center gap-1.5 text-sm font-medium text-navy transition-colors hover:text-navy-light"
        >
          <Icon name="arrow-right" class="h-4 w-4 rotate-180" />
          {backLabel}
        </a>
      </p>
    </div>

    <div class="mt-10">
      <PublicationList publications={pubs} />
    </div>
  </div>
</Layout>
