---
/**
 * Responsive photo grid with a lightbox viewer.
 *
 * Usage:
 *   <PhotoGallery photos={urls} alt="Fieldwork in Chiang Mai" />
 *
 * Clicking a photo opens the lightbox; Esc / close button / backdrop
 * dismiss it, arrow keys navigate, and focus is managed for keyboard users.
 */
interface Props {
  /** Public URLs of the photos to display. */
  photos: string[];
  /** Base alt text (file name is appended for uniqueness). */
  alt: string;
}

const { photos, alt } = Astro.props;
const galleryId = `gallery-${Math.random().toString(36).slice(2, 8)}`;
---

{
  photos.length > 0 ? (
    <div>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {photos.map((photo, index) => (
          <button
            type="button"
            data-gallery-open={galleryId}
            data-index={index}
            class="group relative aspect-square overflow-hidden rounded-lg border border-line bg-paper-dark"
            aria-label={`View photo ${index + 1} of ${photos.length}`}
          >
            <img
              src={photo}
              alt={`${alt} — photo ${index + 1}`}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </button>
        ))}
      </div>

      <!-- Lightbox -->
      <div
        id={`${galleryId}-lightbox`}
        role="dialog"
        aria-modal="true"
        aria-label="Photo viewer"
        class="invisible fixed inset-0 z-50 flex items-center justify-center bg-ink/90 p-4 opacity-0 backdrop-blur-sm transition-opacity duration-200"
        tabindex="-1"
        data-lightbox
        data-gallery={galleryId}
      >
        <button
          type="button"
          data-lightbox-close
          class="absolute right-4 top-4 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
          aria-label="Close photo viewer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
        </button>

        <button
          type="button"
          data-lightbox-prev
          class="absolute left-3 top-1/2 z-10 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 sm:left-6"
          aria-label="Previous photo"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <button
          type="button"
          data-lightbox-next
          class="absolute right-3 top-1/2 z-10 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 sm:right-6"
          aria-label="Next photo"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </button>

        <figure class="flex max-h-full max-w-5xl flex-col items-center">
          <img
            data-lightbox-image
            src=""
            alt=""
            class="max-h-[80vh] max-w-full rounded-lg object-contain shadow-2xl"
          />
          <figcaption data-lightbox-caption class="mt-3 text-sm text-paper/80"></figcaption>
        </figure>
      </div>
    </div>
  ) : (
    <div class="rounded-xl border border-dashed border-line bg-paper-dark p-12 text-center text-sm text-ink-soft">
      No photos have been added to this album yet. Place images inside the album folder
      (<code class="mx-1 rounded bg-paper px-1.5 py-0.5 font-mono text-xs">public/pictures/…</code>)
      to display them here.
    </div>
  )
}

<script define:vars={{ galleryId, photos }} is:inline>
  const lightbox = document.getElementById(`${galleryId}-lightbox`);
  const image = lightbox?.querySelector('[data-lightbox-image]');
  const caption = lightbox?.querySelector('[data-lightbox-caption]');
  let currentIndex = 0;
  let lastFocused = null;

  const openButtons = document.querySelectorAll(`[data-gallery-open="${galleryId}"]`);

  function show(index) {
    currentIndex = (index + photos.length) % photos.length;
    if (image) {
      image.src = photos[currentIndex];
      image.alt = `Photo ${currentIndex + 1} of ${photos.length}`;
    }
    if (caption) {
      caption.textContent = `${currentIndex + 1} / ${photos.length}`;
    }
  }

  function open(index, trigger) {
    if (!lightbox) return;
    lastFocused = trigger;
    show(index);
    lightbox.classList.remove('invisible', 'opacity-0');
    document.body.classList.add('lightbox-open');
    lightbox.focus();
  }

  function close() {
    if (!lightbox) return;
    lightbox.classList.add('invisible', 'opacity-0');
    document.body.classList.remove('lightbox-open');
    lastFocused?.focus();
  }

  openButtons.forEach((button) => {
    button.addEventListener('click', () => open(Number(button.dataset.index), button));
  });

  lightbox?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    if (target.closest('[data-lightbox-close]') || target === lightbox) close();
    if (target.closest('[data-lightbox-prev]')) show(currentIndex - 1);
    if (target.closest('[data-lightbox-next]')) show(currentIndex + 1);
  });

  document.addEventListener('keydown', (event) => {
    if (lightbox?.classList.contains('invisible')) return;
    if (event.key === 'Escape') close();
    if (event.key === 'ArrowLeft') show(currentIndex - 1);
    if (event.key === 'ArrowRight') show(currentIndex + 1);
  });
</script>
