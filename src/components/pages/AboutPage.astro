---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { marked } from 'marked';
import Layout from '../../layouts/Layout.astro';
import Icon from '../Icon.astro';
import { getCollection, render } from 'astro:content';
import { getDictionary, type Locale } from '../../i18n';
import { personLd } from '../../lib/seo';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const metaDescription =
  lang === 'th'
    ? 'ประวัติย่อ พื้นฐานการศึกษา และความสนใจวิจัยของอาจารย์'
    : 'Biography, academic background and research interests.';

// Biography blocks come from the `about` content collection
// (src/content/about/*.md), sorted by `order`. Each block may carry an
// optional image + caption (see the collection schema in content.config.ts).
const blocks = (await getCollection('about')).sort((a, b) => a.data.order - b.data.order);
const renderedBlocks = await Promise.all(
  blocks.map(async (block) => ({ block, Content: (await render(block)).Content })),
);

// schema.org ProfilePage → Person, so the About page is understood as
// describing the site owner.
const aboutLd = [
  {
    '@type': 'ProfilePage',
    name: t.about.title,
    url: getAbsoluteLocaleUrl(lang, '/about'),
    mainEntity: personLd(),
  },
];
---

<Layout title={t.about.title} description={metaDescription} lang={lang} jsonLd={aboutLd}>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <!-- Page header -->
    <div class="max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">{t.about.eyebrow}</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold text-ink">{t.about.title}</h1>
    </div>

    <div class="mt-10 grid gap-14 lg:grid-cols-[1.6fr_1fr]">
      <!-- Main bio (content collection blocks).
           - default: text, with optional image beside it (sides alternate)
           - imageOnly: standalone centered figure (image + caption only) -->
      <div class="max-w-4xl flex flex-col gap-10">
        {
          renderedBlocks.map(({ block, Content }, index) => {
            const hasImage = Boolean(block.data.image);
            const imageOnLeft = index % 2 === 0;
            const figureCaption = lang === 'th' && block.data.captionTh ? block.data.captionTh : block.data.caption;
            const figureAlt = figureCaption ?? t.about.title;

            if (hasImage && block.data.imageOnly) {
              return (
                <figure class="m-0 flex flex-col items-center">
                  <img
                    src={block.data.image!}
                    alt={figureAlt}
                    loading="lazy"
                    class="w-full max-w-sm rounded-xl border border-line object-cover shadow-sm"
                  />
                  {
                    figureCaption && (
                      <figcaption class="mt-2 text-center text-xs leading-relaxed text-ink-soft">
                        {figureCaption}
                      </figcaption>
                    )
                  }
                </figure>
              );
            }

            return (
              <div
                class:list={[
                  hasImage && 'grid gap-6 md:grid-cols-[1fr_0.9fr] md:items-center',
                ]}
              >
                <div class:list={[hasImage && imageOnLeft && 'md:order-1']}>
                  {
                    lang === 'th' && (block.data.textTh ?? '').trim()
                      ? (
                        // textTh is Markdown too — paragraphs, lists, etc.
                        <div class="flex flex-col prose-content text-[15px] space-y-2" set:html={marked.parse(block.data.textTh!)} />
                      )
                      : (
                        <div class="prose-content text-[15px]">
                          <Content />
                        </div>
                      )
                  }
                </div>

                {
                  hasImage && (
                    <figure class:list={['m-0', imageOnLeft ? 'md:order-2' : 'md:order-1']}>
                      <img
                        src={block.data.image!}
                        alt={figureAlt}
                        loading="lazy"
                        class="aspect-[4/3] w-full rounded-xl border border-line object-cover shadow-sm"
                      />
                      {
                        figureCaption && (
                          <figcaption class="mt-2 text-xs leading-relaxed text-ink-soft">
                            {figureCaption}
                          </figcaption>
                        )
                      }
                    </figure>
                  )
                }
              </div>
            );
          })
        }
      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <div class="rounded-xl border border-line bg-white p-6 shadow-sm">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-ink-soft">{t.about.positions}</h2>
          <ul class="mt-4 space-y-4">
            {t.about.positionsList.map((item) => (
              <li>
                <p class="text-sm font-medium text-ink">{item.role}</p>
                <p class="text-sm text-ink-soft">{item.place}</p>
                <p class="text-xs text-ink-soft/80">{item.period}</p>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-xl border border-line bg-white p-6 shadow-sm">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-ink-soft">{t.about.education}</h2>
          <ul class="mt-4 space-y-4">
            {t.about.educationList.map((item) => (
              <li>
                <p class="text-sm font-medium text-ink">{item.degree}</p>
                <p class="text-sm text-ink-soft">{item.place}</p>
                <p class="text-xs text-ink-soft/80">{item.year}</p>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>

    <!-- Research interests -->
    <section class="mt-16 border-t border-line pt-12">
      <h2 class="font-serif text-2xl font-semibold text-ink">{t.about.researchInterests}</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          t.home.interests.map((interest, i) => (
            <div class="flex items-start gap-3 rounded-xl border border-line bg-white p-5 shadow-sm">
              <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-paper-dark text-navy">
                <Icon name={i % 2 === 0 ? 'globe' : 'university'} class="h-4 w-4" />
              </span>
              <p class="text-sm font-medium text-ink">{interest}</p>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
