---
import Layout from '../../layouts/Layout.astro';
import Icon from '../Icon.astro';
import PublicationCard from '../PublicationCard.astro';
import EventCard from '../EventCard.astro';
import { SITE } from '../../site.config';
import { getCollection } from 'astro:content';
import { sortByYearDesc } from '../../lib/publications';
import { personLd } from '../../lib/seo';
import { getDictionary, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const prefix = lang === 'th' ? '/th' : '';

const publications = sortByYearDesc(await getCollection('publications')).slice(0, 3);
const events = (await getCollection('events'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const initials = SITE.name.replace('Dr. ', '').trim().split(/\s+/).map((w) => w[0]).join('');
const affiliation = lang === 'th' ? SITE.affiliationTh : SITE.affiliation;
const description =
  lang === 'th'
    ? 'นักมานุษยวิทยาที่ศึกษาศาสนา พิธีกรรม และความทรงจำร่วมในเอเชียตะวันออกเฉียงใต้ ผลงานตีพิมพ์ทั้งภาษาอังกฤษและภาษาไทย พร้อมภาพถ่ายภาคสนามและข้อมูลติดต่อ'
    : SITE.description;

// schema.org Person — helps search engines and Google Scholar-style
// crawlers associate the site with the author's academic identity.
const personLdNode = [personLd()];
---

<Layout title={SITE.name} description={description} lang={lang} jsonLd={personLdNode}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-steel/10 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -left-24 top-40 h-72 w-72 rounded-full bg-gold/10 blur-3xl" aria-hidden="true"></div>

    <div class="mx-auto grid max-w-6xl gap-12 px-4 pb-16 pt-14 sm:px-6 md:grid-cols-[1.4fr_1fr] md:items-center md:pt-20">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-gold">{t.home.eyebrow}</p>
        <h1 class="mt-4 font-serif text-4xl font-semibold leading-tight text-ink sm:text-5xl">
          {SITE.name}
        </h1>
        <p class="mt-3 text-base text-ink-soft">{affiliation}</p>
        <p class="mt-6 leading-relaxed text-ink-soft">{t.home.intro}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={`${prefix}/publications`}
            class="inline-flex items-center gap-2 rounded-full bg-navy px-6 py-3 text-sm font-medium text-paper transition-colors hover:bg-navy-light"
          >
            {t.home.browsePublications}
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
          <a
            href={`${prefix}/events`}
            class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-navy hover:text-navy"
          >
            {t.home.viewGalleries}
          </a>
        </div>
      </div>

      <!-- Profile portrait placeholder. Replace this card with an <img> of a
           real photograph to personalise the site. -->
      <div class="mx-auto w-full max-w-xs ">
        <img class="rounded-xl border boder-line bg-white shadow-sm" src="/portrait.jpg">
      </div>
    </div>
  </section>

  <!-- Research interests -->
  <section class="border-y border-line bg-paper-dark">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
      <div class="flex flex-wrap items-center gap-2.5">
        <span class="mr-2 text-xs font-semibold uppercase tracking-widest text-ink-soft">{t.home.interestsLabel}</span>
        {
          t.home.interests.map((interest) => (
            <span class="rounded-full border border-line bg-white px-4 py-1.5 text-sm text-ink-soft">
              {interest}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Featured publications -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">{t.home.selectedWork}</p>
        <h2 class="mt-2 font-serif text-3xl font-semibold text-ink">{t.home.recentPublications}</h2>
      </div>
      <a href={`${prefix}/publications`} class="inline-flex items-center gap-1.5 text-sm font-medium text-navy transition-colors hover:text-navy-light">
        {t.home.allPublications}
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>

    {
      publications.length > 0 ? (
        <div class="mt-8 grid gap-6 lg:grid-cols-3">
          {publications.map((pub) => <PublicationCard publication={pub} lang={lang} />)}
        </div>
      ) : (
        <p class="mt-8 rounded-xl border border-dashed border-line bg-paper-dark p-10 text-center text-sm text-ink-soft">
          {lang === 'th'
            ? 'สิ่งพิมพ์จะปรากฏที่นี่เมื่อเพิ่มไฟล์ Markdown ใน src/content/publications/'
            : 'Publications will appear here once Markdown files are added under src/content/publications/.'}
        </p>
      )
    }
  </section>

  <!-- Events teaser -->
  <section class="border-t border-line bg-paper-dark">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">{t.home.inTheField}</p>
          <h2 class="mt-2 font-serif text-3xl font-semibold text-ink">{t.home.eventsTitle}</h2>
        </div>
        <a href={`${prefix}/events`} class="inline-flex items-center gap-1.5 text-sm font-medium text-navy transition-colors hover:text-navy-light">
          {t.home.allGalleries}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>

      {
        events.length > 0 ? (
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {events.map((event) => <EventCard event={event} lang={lang} />)}
          </div>
        ) : (
          <p class="mt-8 rounded-xl border border-dashed border-line bg-paper p-10 text-center text-sm text-ink-soft">
            {lang === 'th'
              ? 'แกลเลอรีภาพจะปรากฏที่นี่เมื่อเพิ่มไฟล์ Markdown ใน src/content/events/'
              : 'Photo galleries will appear here once event Markdown files are added under src/content/events/.'}
          </p>
        )
      }
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="relative overflow-hidden rounded-2xl bg-navy px-8 py-12 text-center sm:px-16">
      <div class="pointer-events-none absolute -left-16 -top-16 h-56 w-56 rounded-full bg-white/5 blur-2xl" aria-hidden="true"></div>
      <h2 class="font-serif text-2xl font-semibold text-paper sm:text-3xl">{t.home.ctaTitle}</h2>
      <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-paper/80">{t.home.ctaText}</p>
      <a
        href={`${prefix}/contact`}
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-paper px-6 py-3 text-sm font-semibold text-navy transition-colors hover:bg-paper-dark"
      >
        <Icon name="mail" class="h-4 w-4" />
        {t.home.getInTouch}
      </a>
    </div>
  </section>
</Layout>
