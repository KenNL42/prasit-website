---
import Layout from '../../layouts/Layout.astro';
import Icon from '../Icon.astro';
import PhotoGallery from '../PhotoGallery.astro';
import { render, type CollectionEntry } from 'astro:content';
import { listAlbumPhotoUrls } from '../../lib/albums';
import { SITE } from '../../site.config';
import { getDictionary, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
  album: CollectionEntry<'photos'>;
}

const { lang, album } = Astro.props;
const t = getDictionary(lang);
const { Content } = await render(album);

const photos = listAlbumPhotoUrls(album.data.album);
const formattedDate = album.data.date
  ? album.data.date.toLocaleDateString(lang === 'th' ? 'th-TH' : 'en-GB', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : undefined;
const bodyText = (album.body ?? '').trim();
const descriptionTh = (album.data.descriptionTh ?? '').trim();
const hasEnglishDescription = bodyText.length > 0;
const hasThaiDescription = descriptionTh.length > 0;
const albumImages = photos.slice(0, 5);
const prefix = lang === 'th' ? '/th' : '';

const metaDescription =
  lang === 'th'
    ? `${album.data.title} — คลังภาพถ่าย${album.data.location ? `, ${album.data.location}` : ''}`
    : `${album.data.title} — photo gallery${album.data.location ? `, ${album.data.location}` : ''}.`;

// schema.org ImageGallery — exposes the album to search engines.
const galleryLd = [
  {
    '@type': 'ImageGallery',
    name: album.data.title,
    ...(hasEnglishDescription ? { description: bodyText.slice(0, 500) } : {}),
    ...(albumImages.length > 0
      ? { image: albumImages.map((url) => new URL(url, SITE.url).toString()) }
      : {}),
  },
];
---

<Layout
  title={album.data.title}
  description={metaDescription}
  lang={lang}
  type="article"
  jsonLd={galleryLd}
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center gap-2 text-sm text-ink-soft">
        <li><a href={`${prefix}/photos`} class="transition-colors hover:text-navy">{t.photos.breadcrumb}</a></li>
        <li aria-hidden="true"><Icon name="chevron-right" class="h-3.5 w-3.5" /></li>
        <li class="truncate text-ink">{album.data.title}</li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="max-w-3xl">
      <h1 class="font-serif text-4xl font-semibold leading-tight text-ink">{album.data.title}</h1>
      <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-ink-soft">
        {
          formattedDate && (
            <span class="inline-flex items-center gap-2">
              <Icon name="calendar" class="h-4 w-4 text-navy" />
              <time datetime={album.data.date!.toISOString()}>{formattedDate}</time>
            </span>
          )
        }
        {
          album.data.location && (
            <span class="inline-flex items-center gap-2">
              <Icon name="location" class="h-4 w-4 text-navy" />
              {album.data.location}
            </span>
          )
        }
        <span class="inline-flex items-center gap-2">
          <Icon name="university" class="h-4 w-4 text-navy" />
          {t.common.photos(photos.length)}
        </span>
      </div>
    </header>

    <!-- Description -->
    {
      lang === 'th' && hasThaiDescription ? (
        <div class="mt-6 max-w-3xl whitespace-pre-line text-[15px] leading-relaxed text-ink-soft">
          {descriptionTh}
        </div>
      ) : hasEnglishDescription ? (
        <div class="prose-content mt-6 max-w-3xl">
          <Content />
        </div>
      ) : null
    }

    <!-- Gallery -->
    <section class="mt-10" aria-label={album.data.title}>
      <PhotoGallery photos={photos} alt={album.data.title} lang={lang} />
    </section>

    <!-- Back link -->
    <p class="mt-12">
      <a
        href={`${prefix}/photos`}
        class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-navy hover:text-navy"
      >
        <Icon name="chevron-left" class="h-4 w-4" />
        {t.common.backToPhotos}
      </a>
    </p>
  </div>
</Layout>
