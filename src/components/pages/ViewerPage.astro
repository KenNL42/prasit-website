---
import Layout from '../../layouts/Layout.astro';
import Icon from '../Icon.astro';
import { getDictionary, type Locale } from '../../i18n';
import { readdirSync, existsSync } from 'node:fs';

interface Props {
  lang: Locale;
  /** Content collection entry id (the md file base name) — also the pdf-pages folder name. */
  id: string;
  title: string;
  /** Neutral back link (the component adds the /th prefix for Thai pages). */
  back: string;
}

const { lang, id, title, back } = Astro.props;
const t = getDictionary(lang);
const prefix = lang === 'th' ? '/th' : '';

const pagesDir = new URL(`../../../public/pdf-pages/${id}`, import.meta.url);
let pages: string[] = [];
if (existsSync(pagesDir)) {
  pages = readdirSync(pagesDir)
    .filter((f) => /\.jpe?g$/i.test(f))
    .sort();
}
---

<Layout title={title} lang={lang} description={t.publications.viewOnlyNote}>
  <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
    <nav class="mb-8 text-sm text-ink-soft" aria-label="Breadcrumb">
      <a href={`${prefix}${back}`} class="inline-flex items-center gap-1.5 transition-colors hover:text-navy">
        <Icon name="chevron-left" class="h-3.5 w-3.5" />
        {t.publications.breadcrumb}
      </a>
    </nav>

    <h1 class="font-serif text-3xl font-semibold text-ink">{title}</h1>
    <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-gold/15 px-3.5 py-1.5 text-xs font-medium text-navy">
      <Icon name="eye" class="h-3.5 w-3.5" />
      {t.publications.viewOnlyNote}
    </p>

    <div class="mt-8 space-y-6">
      {pages.length > 0 ? (
        pages.map((p) => (
          <img
            src={`/pdf-pages/${id}/${p}`}
            alt={`${title} — ${p.replace(/\.jpe?g$/i, '')}`}
            loading="lazy"
            class="w-full rounded-lg border border-line bg-white shadow-sm"
          />
        ))
      ) : (
        <p class="text-sm text-ink-soft">{t.publications.viewerEmpty}</p>
      )}
    </div>
  </div>
</Layout>