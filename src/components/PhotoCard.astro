---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { coverPhotoUrl, listAlbumPhotos } from '../lib/albums';
import { getDictionary, type Locale } from '../i18n';

interface Props {
  /** A person's photo album (entry of the `photos` collection). */
  album: CollectionEntry<'photos'>;
  /** UI language of the surrounding page. */
  lang?: Locale;
}

const { album, lang = 'en' } = Astro.props;
const t = getDictionary(lang);
const prefix = lang === 'th' ? '/th' : '';
const cover = coverPhotoUrl(album.data.album, album.data.cover);
const photoCount = listAlbumPhotos(album.data.album).length;
const formattedDate = album.data.date
  ? album.data.date.toLocaleDateString(lang === 'th' ? 'th-TH' : 'en-GB', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : undefined;
---

<a
  href={`${prefix}/photos/${album.id}/`}
  class="group flex flex-col overflow-hidden rounded-xl border border-line bg-white shadow-sm transition-shadow hover:shadow-md"
>
  <div class="relative aspect-[4/3] overflow-hidden bg-paper-dark">
    {
      cover ? (
        <img
          src={cover}
          alt={`${album.data.title} — ${lang === 'th' ? 'ภาพปก' : 'cover photo'}`}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-ink-soft">
          <Icon name="university" class="h-10 w-10 opacity-40" />
        </div>
      )
    }
    {
      photoCount > 0 && (
        <span class="absolute bottom-3 right-3 rounded-full bg-ink/70 px-3 py-1 text-xs font-medium text-paper backdrop-blur">
          {t.common.photos(photoCount)}
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-serif text-lg font-semibold text-ink transition-colors group-hover:text-navy">
      {album.data.title}
    </h3>
    <p class="mt-auto flex items-center gap-1.5 pt-4 text-sm font-medium text-navy">
      {t.common.viewGallery}
      <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
    </p>
  </div>
</a>
