---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../site.config';

const profileEntries = Object.entries(SITE.profiles);
---

<Layout
  title="Contact"
  description={`Contact ${SITE.name} — email, office address and academic profiles.`}
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">Contact</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold text-ink">Get in touch</h1>
      <p class="mt-4 text-[15px] leading-relaxed text-ink-soft">
        For correspondence about research collaboration, graduate supervision, invited talks or
        media inquiries, the quickest way to reach me is by email. I usually respond within a few
        working days.
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-[1.2fr_1fr]">
      <!-- Quick message form (opens the visitor's mail client — no backend needed) -->
      <section class="rounded-2xl border border-line bg-white p-7 shadow-sm sm:p-8" aria-labelledby="message-heading">
        <h2 id="message-heading" class="font-serif text-xl font-semibold text-ink">Send a message</h2>
        <form class="mt-6 space-y-5">
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-1.5 block text-sm font-medium text-ink">Name</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                class="w-full rounded-lg border border-line bg-paper px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-soft/60 focus:border-navy focus:outline-none focus:ring-2 focus:ring-navy/20"
              />
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-medium text-ink">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                class="w-full rounded-lg border border-line bg-paper px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-soft/60 focus:border-navy focus:outline-none focus:ring-2 focus:ring-navy/20"
              />
            </div>
          </div>
          <div>
            <label for="subject" class="mb-1.5 block text-sm font-medium text-ink">Subject</label>
            <input
              id="subject"
              name="subject"
              type="text"
              required
              class="w-full rounded-lg border border-line bg-paper px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-soft/60 focus:border-navy focus:outline-none focus:ring-2 focus:ring-navy/20"
            />
          </div>
          <div>
            <label for="message" class="mb-1.5 block text-sm font-medium text-ink">Message</label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              class="w-full resize-y rounded-lg border border-line bg-paper px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-soft/60 focus:border-navy focus:outline-none focus:ring-2 focus:ring-navy/20"
            ></textarea>
          </div>
          <button
            type="submit"
            class="inline-flex items-center gap-2 rounded-full bg-navy px-6 py-3 text-sm font-medium text-paper transition-colors hover:bg-navy-light"
          >
            <Icon name="mail" class="h-4 w-4" />
            Send via email
          </button>
          <p class="text-xs leading-relaxed text-ink-soft">
            This form opens your email client with the message pre-filled — nothing is stored on
            this website.
          </p>
        </form>
      </section>

      <div class="space-y-6">
        <!-- Direct email -->
        <section class="rounded-2xl border border-line bg-white p-7 shadow-sm">
          <h2 class="font-serif text-lg font-semibold text-ink">Direct email</h2>
          <a
            href={`mailto:${SITE.email}`}
            class="mt-3 inline-flex items-center gap-2 break-all text-sm font-medium text-navy transition-colors hover:text-navy-light"
          >
            <Icon name="mail" class="h-4 w-4 shrink-0" />
            {SITE.email}
          </a>
        </section>

        <!-- Office -->
        <section class="rounded-2xl border border-line bg-white p-7 shadow-sm">
          <h2 class="font-serif text-lg font-semibold text-ink">Office</h2>
          <p class="mt-3 flex items-start gap-2 text-sm leading-relaxed text-ink-soft">
            <Icon name="location" class="mt-0.5 h-4 w-4 shrink-0 text-navy" />
            <span>
              {SITE.address.map((line) => <span class="block">{line}</span>)}
            </span>
          </p>
        </section>

        <!-- Academic profiles -->
        <section class="rounded-2xl border border-line bg-white p-7 shadow-sm">
          <h2 class="font-serif text-lg font-semibold text-ink">Academic profiles</h2>
          <ul class="mt-3 space-y-2.5">
            {profileEntries.map(([label, url]) => (
              <li>
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-sm font-medium text-navy transition-colors hover:text-navy-light"
                >
                  {label}
                  <Icon name="external" class="h-3.5 w-3.5" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ emailAddress: SITE.email }} is:inline>
  // Pre-fill a mailto: message from the form fields.
  const form = document.querySelector('form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') ?? '');
    const email = String(data.get('email') ?? '');
    const subject = String(data.get('subject') ?? '');
    const message = String(data.get('message') ?? '');
    const body = `From: ${name} <${email}>\n\n${message}`;
    window.location.href = `mailto:${emailAddress}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
