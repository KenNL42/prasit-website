---
import Layout from '../layouts/Layout.astro';
import { getDictionary } from '../i18n';
---

<Layout
  title="Page not found"
  description="The page you are looking for does not exist."
  lang="en"
>
  <div class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center">
    <p class="font-serif text-7xl font-semibold text-navy">404</p>
    <h1 class="mt-4 text-2xl font-semibold text-navy">{getDictionary('en').common.notFound}</h1>
    <p class="mt-3 text-navy-muted">
      {getDictionary('en').common.notFoundHint} ·
      {getDictionary('th').common.notFoundHint}
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/" class="rounded-full bg-navy px-6 py-2.5 text-sm font-medium text-white transition-colors hover:bg-navy-light">
        {getDictionary('en').nav.home}
      </a>
      <a href="/th/" class="rounded-full border border-navy px-6 py-2.5 text-sm font-medium text-navy transition-colors hover:bg-navy hover:text-white">
        {getDictionary('th').nav.home} (ไทย)
      </a>
    </div>
  </div>
</Layout>