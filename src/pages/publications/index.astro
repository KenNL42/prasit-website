---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';
import { sortByYearDesc } from '../../lib/publications';

const publications = await getCollection('publications');
const enCount = publications.filter((p) => p.data.language === 'en').length;
const thCount = publications.filter((p) => p.data.language === 'th').length;
const latest = sortByYearDesc(publications)[0];
---

<Layout
  title="Publications"
  description="Peer-reviewed publications, book chapters and working papers in English and Thai, with abstracts and downloadable PDFs."
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">Publications</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold text-ink">Research publications</h1>
      <p class="mt-4 text-[15px] leading-relaxed text-ink-soft">
        My published work spans English- and Thai-language venues. Each entry lists the abstract
        and a downloadable PDF where available.
        {latest && ` The most recent addition is from ${latest.data.year}.`}
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <!-- English -->
      <a
        href="/publications/english"
        class="group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-white p-8 shadow-sm transition-shadow hover:shadow-md"
      >
        <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-steel/10 blur-2xl" aria-hidden="true"></div>
        <span class="inline-flex w-fit items-center gap-2 rounded-full bg-paper-dark px-3.5 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-navy">
          <Icon name="globe" class="h-3.5 w-3.5" />
          English
        </span>
        <h2 class="mt-5 font-serif text-2xl font-semibold text-ink">Publications in English</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          Journal articles, book chapters and reviews for international readership —
          {enCount} entr{enCount === 1 ? 'y' : 'ies'}.
        </p>
        <p class="mt-auto flex items-center gap-1.5 pt-6 text-sm font-medium text-navy">
          Browse English publications
          <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
        </p>
      </a>

      <!-- Thai -->
      <a
        href="/publications/thai"
        class="group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-white p-8 shadow-sm transition-shadow hover:shadow-md"
        lang="th"
      >
        <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-gold/10 blur-2xl" aria-hidden="true"></div>
        <span class="inline-flex w-fit items-center gap-2 rounded-full bg-navy px-3.5 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-paper">
          <Icon name="globe" class="h-3.5 w-3.5" />
          ภาษาไทย
        </span>
        <h2 class="mt-5 font-serif text-2xl font-semibold text-ink">สิ่งพิมพ์ภาษาไทย</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          บทความและงานเขียนภาษาไทยสำหรับผู้อ่านในประเทศ —
          {thCount} รายการ
        </p>
        <p class="mt-auto flex items-center gap-1.5 pt-6 text-sm font-medium text-navy">
          ดูสิ่งพิมพ์ภาษาไทย
          <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
        </p>
      </a>
    </div>
  </div>
</Layout>
